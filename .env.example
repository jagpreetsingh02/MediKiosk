# ---------------------------------------------------------------- application
ENVIRONMENT=dev              # dev | test | prod
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- persistence
# SQLite is the default so `pytest` and a cold clone run with no Docker and no network.
#
# For Supabase, use the SESSION POOLER string from the dashboard
# (Project Settings -> Database -> Connection string -> Session pooler), rewritten for the
# async driver. See docs/SUPABASE.md for why the pooler and not the direct connection:
#
#   DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Set REQUIRE_SUPABASE=true alongside it, so the app refuses to start on SQLite by accident
# rather than serving an empty patient history that looks like a working demo.
DATABASE_URL=sqlite+aiosqlite:///./medikiosk.db
DB_ECHO=false
REDIS_URL=redis://localhost:6379/0
SESSION_STORE_ALLOW_MEMORY_FALLBACK=true

# --- Supabase ------------------------------------------------------------------
# Backend only. SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely; it must never reach the
# browser, any VITE_* variable, or a commit. See docs/SUPABASE_SECURITY.md.
REQUIRE_SUPABASE=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=medical-documents

# ---------------------------------------------------------------- session lifecycle (Invariant 6)
SESSION_TTL_SECONDS=3600
PURGE_ON_SUBMIT=true

# ---------------------------------------------------------------- LLM
# `offline` is the safe default: the deterministic extractor. `auto` uses Groq when a key is
# present and silently stays offline when it is not — the demo never depends on a network.
LLM_BACKEND=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b   # llama-3.3-70b-versatile was decommissioned
GROQ_ASR_MODEL=whisper-large-v3-turbo
LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------- speech
SPEECH_BACKEND=local        # local | whisper | bhashini | client
ASR_CONFIDENCE_THRESHOLD=0.62
VOSK_MODEL_DIR=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# ---------------------------------------------------------------- documents
# Only consulted when a caller names an engine explicitly. Every patient upload is routed
# by what the FILE IS: a photograph goes to the handwriting model and falls back to Tesseract;
# a PDF tries its text layer first. See app/modules/documents/backends.py::_chain.
OCR_BACKEND=textlayer        # textlayer | tesseract | trocr
OCR_LOW_CONFIDENCE_THRESHOLD=0.72
# Re-read ambiguous lines with Tesseract and let disagreement cost confidence. Costs one
# subprocess per ambiguous line, and can only ever move a line TOWARD human verification.
OCR_CORROBORATE=true

# --- handwriting OCR (optional) --------------------------------------------------
# Needs `make setup-handwriting` (torch + transformers, a large download). Without it the
# engine reports itself unavailable and photographs go to Tesseract — which reads printed
# prescriptions well and handwriting poorly. Nothing else changes.
HANDWRITING_OCR_ENABLED=true
TROCR_MODEL_ID=khedim/Medical-Prescription-OCR
# `khedim/Medical-Prescription-OCR` is a GATED Hugging Face repo: the download 401s unless the
# token below belongs to an account that has been granted access. A 401 is treated like any
# other unavailability — fall back to Tesseract, log the reason, and report it at GET /about.
# Never logged and never printed. Leave blank to run without the handwriting model.
HF_TOKEN=
TROCR_DEVICE=auto            # auto | cpu | cuda | mps
# A page whose lines the model reads fewer than this fraction of goes to Tesseract WHOLE. A
# prescription read in part is a prescription with medicines missing and no gap to show it.
TROCR_MIN_LINE_YIELD=0.6

# --- prescription interpretation --------------------------------------------------
# How close a misread medicine name must be to a name in data/terminology/medications.json
# before it is corrected AUTOMATICALLY rather than offered as a suggestion. Calibrated by the
# adversarial sweep in tests/test_prescription_interpretation.py — lower it and that test
# fails, which is the intended relationship between the two.
RX_NAME_AUTO_SIMILARITY=0.86
RX_NAME_MARGIN=0.06
RX_NAME_MIN_OCR_CONFIDENCE=0.55

# ---------------------------------------------------------------- terminology
NAMASTE_VERSION=1.0
ICD_RELEASE_ID=2026-01
DASHAVIDHA_VERSION=0.1.0

# ---------------------------------------------------------------- auth & policy
AUTH_REQUIRED=false          # true in any deployed environment
JWT_SECRET=dev-only-not-a-real-secret-change-me-in-any-deployment
JWT_ISSUER=mock-abdm-idp     # a MOCK issuer. Never presented as real ABDM.
JWT_AUDIENCE=medikiosk
POLICY_FILE=config/policy.yaml

# ---------------------------------------------------------------- HIS push
HIS_FHIR_ENDPOINT=http://localhost:8000/api/v1/stub-his/Bundle

# ---------------------------------------------------------------- AYUSH
AYUSH_MODE_DEFAULT=false
